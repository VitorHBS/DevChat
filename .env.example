# URL de conexão com o banco Postgres (rodando via Docker)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://livechat_user:livechat_pass@localhost:5434/livechat_db?schema=public"

# Chave secreta usada para assinar e validar os tokens JWT
# Gere uma string aleatória longa e única para cada ambiente
JWT_SECRET="coloque_uma_chave_secreta_aqui"

# Porta em que o servidor Express vai rodar
PORT=3000